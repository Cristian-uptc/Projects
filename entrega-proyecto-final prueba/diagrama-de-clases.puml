@startuml
!pragma layout smetana
title Package model - Sports Court Reservation System

skinparam classAttributeIconSize 0
hide empty members

package "model" {

  interface Serializable <<java.io>>

  class ReservationSystem {
    - administrator : Administrator
    - clients : List<Client>
    - courts : List<Court>
    - reservations : List<Reservation>
    - waitlist : Queue<WaitlistRequest>
    - nextCourtId : int
    - nextReservationId : int
    - nextRequestId : int
    + ReservationSystem(administrator : Administrator)
    + login(username : String, password : String) : User
    + registerClient(client : Client) : void
    + addCourt(name : String, sport : String, capacity : int, hourlyRate : double) : Court
    + editCourt(courtId : int, name : String, sport : String, capacity : int, hourlyRate : double) : void
    + deactivateCourt(courtId : int) : void
    + getCourts() : List<Court>
    + getActiveCourts() : List<Court>
    + getOccupiedSlots(court : Court, date : LocalDate) : List<TimeSlot>
    + createReservation(timeSlot : TimeSlot, client : Client) : Reservation
    + cancelReservation(reservationId : int, client : Client) : Reservation
    + getReservationsByClient(client : Client) : List<Reservation>
    + joinWaitlist(timeSlot : TimeSlot, client : Client) : WaitlistRequest
    + getWaitlistByClient(client : Client) : List<WaitlistRequest>
    - assignFreedSlot(timeSlot : TimeSlot) : Reservation
    - discardExpiredRequests(now : LocalDateTime) : void
  }

  abstract class User {
    - username : String
    - password : String
    + User(username : String, password : String)
    + getUsername() : String
    + validateCredentials(username : String, password : String) : boolean
    + {abstract} getRole() : Role
  }

  class Client {
    - name : String
    - documentId : String
    - phone : String
    + Client(name : String, documentId : String, phone : String, username : String, password : String)
    + getName() : String
    + getDocumentId() : String
    + getPhone() : String
    + getRole() : Role
  }

  class Administrator {
    + Administrator(username : String, password : String)
    + getRole() : Role
  }

  enum Role {
    CLIENT
    ADMINISTRATOR
  }

  class Court {
    - id : int
    - name : String
    - sport : String
    - capacity : int
    - hourlyRate : double
    - active : boolean
    + Court(id : int, name : String, sport : String, capacity : int, hourlyRate : double)
    + getId() : int
    + getName() : String
    + getSport() : String
    + getCapacity() : int
    + getHourlyRate() : double
    + isActive() : boolean
    + setName(name : String) : void
    + setSport(sport : String) : void
    + setCapacity(capacity : int) : void
    + setHourlyRate(hourlyRate : double) : void
    + setActive(active : boolean) : void
    + equals(o : Object) : boolean
    + hashCode() : int
  }

  class TimeSlot {
    - date : LocalDate
    - startHour : int
    + TimeSlot(court : Court, date : LocalDate, startHour : int)
    + getCourt() : Court
    + getDate() : LocalDate
    + getStartHour() : int
    + getStartDateTime() : LocalDateTime
    + getEndDateTime() : LocalDateTime
    + hasPassed(now : LocalDateTime) : boolean
    + equals(o : Object) : boolean
    + hashCode() : int
  }

  enum ReservationStatus {
    ACTIVE
    CANCELLED
    FINISHED
  }

  class Reservation {
    - id : int
    + Reservation(id : int, timeSlot : TimeSlot, client : Client)
    + getId() : int
    + getTimeSlot() : TimeSlot
    + getClient() : Client
    + getStatus(now : LocalDateTime) : ReservationStatus
    + isActive(now : LocalDateTime) : boolean
    + canCancel(now : LocalDateTime) : boolean
    + cancel() : void
  }

  class WaitlistRequest {
    - id : int
    - requestDateTime : LocalDateTime
    + WaitlistRequest(id : int, timeSlot : TimeSlot, client : Client)
    + getId() : int
    + getTimeSlot() : TimeSlot
    + getClient() : Client
    + getRequestDateTime() : LocalDateTime
    + isExpired(now : LocalDateTime) : boolean
  }
}

User <|-- Client
User <|-- Administrator

Serializable <|.. ReservationSystem
Serializable <|.. User
Serializable <|.. Court
Serializable <|.. TimeSlot
Serializable <|.. Reservation
Serializable <|.. WaitlistRequest

ReservationSystem *-- "1" Administrator : administrator
ReservationSystem *-- "*" Client : clients
ReservationSystem *-- "*" Court : courts
ReservationSystem *-- "*" Reservation : reservations
ReservationSystem *-- "*" WaitlistRequest : waitlist

User "*" --> "1" Role : role
TimeSlot "*" --> "1" Court : court
Reservation "*" --> "1" TimeSlot : timeSlot
Reservation "*" --> "1" Client : client
Reservation "*" --> "1" ReservationStatus : status
WaitlistRequest "*" --> "1" TimeSlot : timeSlot
WaitlistRequest "*" --> "1" Client : client

@enduml
